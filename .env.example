# ==========================================================================
#  CONFIGURACIÓN DE CREADOR DE VIDEOS — COPIA ESTE ARCHIVO COMO  .env
#  (En Windows:  copy .env.example .env    |    En Linux:  cp .env.example .env)
#
#  AQUÍ es donde van TODAS tus API keys. Rellena solo las que vayas a usar.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) MOTOR DE GUION (elige cuál usar con VIDEO_LLM_PROVIDER)
#    Opciones: opencode | gemini | openai | ollama | demo
# --------------------------------------------------------------------------
VIDEO_LLM_PROVIDER=opencode

# --- OpenCode Go (tu proveedor principal) ---------------------------------
#  Consíguela en: https://opencode.ai  ->  Console  ->  API Keys
OPENCODE_API_KEY=
#  Modelo a usar. Mira los disponibles con el botón "Modelos" del panel,
#  o con:  curl -H "Authorization: Bearer TU_KEY" https://opencode.ai/inference/go/v1/models
OPENCODE_MODEL=glm-5.3
#  Endpoints del plan Go (chat y lista de modelos usan rutas distintas):
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODELS_URL=https://opencode.ai/inference/go/v1/models

# --- Gemini (alternativa) -------------------------------------------------
#  Consíguela en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (alternativa) -------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama local / gratis (alternativa) ----------------------------------
#  Requiere instalar Ollama (https://ollama.com) y hacer:  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --------------------------------------------------------------------------
# 2) SUBIDA AUTOMÁTICA A YOUTUBE  (YouTube Data API v3)
#    Pasos:
#      1. Ve a https://console.cloud.google.com/
#      2. Crea un proyecto -> Habilita "YouTube Data API v3"
#      3. Pantalla de consentimiento OAuth (tipo "Externo", añádete como tester)
#      4. Crea credenciales -> "ID de cliente de OAuth" -> "App de escritorio"
#      5. Descarga el JSON y guárdalo como:  credentials/youtube_client_secret.json
# --------------------------------------------------------------------------
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
#  Privacidad por defecto al subir: private | unlisted | public
YOUTUBE_PRIVACY=private

# --------------------------------------------------------------------------
# 3) SUBIDA AUTOMÁTICA A TIKTOK  (Content Posting API)
#    Pasos:
#      1. Ve a https://developers.tiktok.com/ -> crea una app
#      2. Añade el producto "Content Posting API" (requiere revisión de TikTok)
#      3. Copia Client Key y Client Secret aquí abajo
#    NOTA: hasta que TikTok apruebe la app, los videos se suben como BORRADOR
#          privado que tú publicas desde la app de TikTok.
# --------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=credentials/tiktok_token.json

# --------------------------------------------------------------------------
# 4) AJUSTES GENERALES
# --------------------------------------------------------------------------
#  Idioma y voz por defecto
VIDEO_LANG=es
VIDEO_VOICE_ES=es-CO-GonzaloNeural
VIDEO_VOICE_EN=en-US-ChristopherNeural
#  Carpeta de salida de los videos
OUTPUT_DIR=output_videos
#  Ruta a FFmpeg (déjalo vacío si ya está en el PATH del sistema)
FFMPEG_PATH=
#  Host y puerto del panel web
WEB_HOST=127.0.0.1
WEB_PORT=8000
