# =============================================================================
# Cybercrime Studio — Plantilla de configuración
# Copia este archivo a `.env` y rellena las claves que vayas a usar.
# =============================================================================

# --- Proveedor de IA principal: opencode | gemini | openai | ollama | demo ---
VIDEO_LLM_PROVIDER=opencode

# OpenCode Go (principal) — https://opencode.ai -> Console -> API Keys
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODELS_URL=https://opencode.ai/inference/go/v1/models

# Google Gemini (alternativa) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI o endpoint compatible (alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (gratis, sin API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Identidad del canal (intro / outro) ---
BRAND_NAME=DÍA CERO
BRAND_TAGLINE_ES=Caso real de ciberseguridad
BRAND_TAGLINE_EN=Real cybersecurity case

# --- Idioma y voces por defecto (Edge TTS) ---
VIDEO_LANG=es
VIDEO_VOICE_ES=es-CO-GonzaloNeural
VIDEO_VOICE_EN=en-US-ChristopherNeural

# --- Rendimiento y audio ---
RENDER_CONCURRENCY=2
AUDIO_LOUDNORM=true
KEEP_TEMP_FILES=false

# --- Panel web ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
OUTPUT_DIR=output_videos
# FFMPEG_PATH=C:\ffmpeg\bin

# --- YouTube Data API v3 (OAuth escritorio) ---
# Descarga el JSON de Google Cloud y guárdalo en credentials/youtube_client_secret.json
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_PRIVACY=private

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=credentials/tiktok_token.json
